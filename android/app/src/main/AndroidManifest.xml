<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <!-- Underlay DHT/UDX traffic; no overlay traffic leaves the device unencrypted. -->
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <!-- The established tunnel keeps a foreground VPN notification. -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SYSTEM_EXEMPTED" />
  <!-- A pairing session is a short foreground data exchange; it has no tunnel. -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

  <application
    android:allowBackup="false"
    android:label="@string/app_name"
    android:supportsRtl="true"
    android:theme="@style/Theme.Kepos">

    <activity
      android:name=".ui.MainActivity"
      android:exported="true"
      android:label="@string/app_name">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>

    <!--
      Only the system, which holds BIND_VPN_SERVICE, may start or bind this
      service. Exported with that signature permission is the documented shape
      for a VpnService; other apps cannot bind it.

      This build does not support always-on VPN or lockdown mode, so it opts out
      through the documented metadata (absent means supported). The platform
      rejects and clears an always-on setting for an opted-out package; whether
      the system Settings screen hides the option is not verified here.
    -->
    <service
      android:name=".vpn.KeposVpnService"
      android:exported="true"
      android:foregroundServiceType="systemExempted|dataSync"
      android:permission="android.permission.BIND_VPN_SERVICE">
      <intent-filter>
        <action android:name="android.net.VpnService" />
      </intent-filter>
      <meta-data
        android:name="android.net.VpnService.SUPPORTS_ALWAYS_ON"
        android:value="false" />
    </service>
  </application>

</manifest>
