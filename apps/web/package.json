{
  "name": "@tta-lab/kepos-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "check": "biome check .",
    "check:write": "biome check --write .",
    "deploy": "npm run verify && wrangler deploy",
    "deploy:dry-run": "npm run build && wrangler deploy --dry-run",
    "verify": "npm run test && npm run check && npm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "wrangler": "^4.113.0"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "lucide": "^1.25.0"
  }
}
