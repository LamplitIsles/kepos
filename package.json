{
  "name": "kepos",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <13"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24 <25",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": ">=11 <13",
      "onFail": "error"
    }
  },
  "scripts": {
    "web:dev": "npm run dev --workspace @lamplitisles/kepos-web",
    "web:build": "npm run build --workspace @lamplitisles/kepos-web",
    "web:test": "npm run test --workspace @lamplitisles/kepos-web",
    "web:check": "npm run check --workspace @lamplitisles/kepos-web",
    "web:verify": "npm run verify --workspace @lamplitisles/kepos-web",
    "web:deploy:dry-run": "npm run deploy:dry-run --workspace @lamplitisles/kepos-web",
    "web:deploy": "npm run deploy --workspace @lamplitisles/kepos-web",
    "vpn:build": "mkdir -p .build && cc -std=c11 -O2 -Wall -Wextra -Werror -o .build/kepos-tun src/vpn/native/tun.c",
    "kepos": "tsx src/cli/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "check": "npm run vpn:build && npm run typecheck && npm test && npm run web:verify"
  },
  "dependencies": {
    "b4a": "^1.8.1",
    "fs-native-extensions": "1.5.1",
    "hypercore-crypto": "^3.7.0",
    "hyperdht": "^6.33.0",
    "smol-toml": "^1.7.0",
    "tsx": "^4.23.1"
  },
  "devDependencies": {
    "@hyperswarm/secret-stream": "^6.9.1",
    "@types/b4a": "^1.6.5",
    "@types/node": "^26.1.1",
    "lefthook": "^2.1.10",
    "streamx": "^2.28.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.118.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "lefthook@2.1.10": true,
    "workerd@1.20260730.1": true
  },
  "overrides": {
    "undici": "7.29.0"
  }
}
